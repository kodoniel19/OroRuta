# Location of the Android SDK on your laptop
# Windows example: C:\\Users\\YOUR_USERNAME\\AppData\\Local\\Android\\Sdk
# macOS example: /Users/YOUR_USERNAME/Library/Android/sdk
# Linux example: /home/YOUR_USERNAME/Android/Sdk
sdk.dir=C:\\Users\\YOUR_USERNAME\\AppData\\Local\\Android\\Sdk

# Google Maps Android API Key
# 1. Go to Google Cloud Console -> APIs & Services -> Credentials
# 2. Create an API Key and enable "Maps SDK for Android"
# 3. (Optional but recommended) Restrict the key to Android apps:
#    Package name: com.ororuta.app
#    SHA-1 fingerprint: from your debug.keystore or release keystore
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
