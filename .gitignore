# ============================================================
# OroRuta .gitignore - Multiplatform Transit Application
# Covers: Android (Kotlin), Node.js (Backend), React/Vite (Admin Web)
# ============================================================

# ─── SECRETS & LOCAL CREDENTIALS (NEVER COMMIT) ─────────────
*.env
*.env.*
!.env.example
*.local
local.properties
android/local.properties
!android/local.properties.example
*.keystore
*.jks
credentials.json
google-services.json

# ─── ANDROID BUILD OUTPUTS & CACHES ─────────────────────────
.gradle/
build/
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/.cxx/
android/.cxx/
android/captures/
*.apk
*.ap_
*.aab
*.dex
*.class

# ─── NODE.JS & NPM ──────────────────────────────────────────
node_modules/
backend/node_modules/
admin-web/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ─── ADMIN WEB BUILD OUTPUTS ────────────────────────────────
admin-web/dist/
admin-web/dist-ssr/
*.tsbuildinfo

# ─── SCRATCH & TEMPORARY FILES ──────────────────────────────
/scratch/
pdf_build/
*.pdf
backend/scratch/*.tmp
backend/scratch/geocode_cache.json


# ─── IDE & SYSTEM FILES ─────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
