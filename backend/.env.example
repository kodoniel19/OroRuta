# ============================================================
# OroRuta Backend API Configuration
# Copy this file to backend/.env and update values as needed.
# ============================================================

# Environment: 'development' or 'production'
NODE_ENV=development

# HTTP Server Port
PORT=3000

# MySQL Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=ororuta
DB_PASS=ororuta
DB_NAME=ororuta

# Secret key required for admin endpoints (X-Admin-Key header)
ADMIN_API_KEY=change-me-in-production
